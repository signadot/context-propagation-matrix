.tools/
relays/go-otelc/.otelc-build/

# Installed dependencies. The lockfiles next to the manifests
# (relays/node/package-lock.json, relays/php/composer.lock) are committed.
node_modules/
/relays/php/vendor/

.env
.env.*
!.env.example

# Harness outputs are published as GitHub Release assets (run-YYYY-MM-DD),
# never committed: raw driver output, the aggregated results.json/MATRIX.md,
# and the sink's append-only observation log (a local debugging aid).
# `./run.sh fetch` restores results/latest (and -raw results/raw) from the
# latest release. results/experiments and results/nokey are hand-curated
# evidence and stay tracked.
results/raw/
results/latest/
results/data/
results/MATRIX.md
