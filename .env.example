# Copy to .env (gitignored). Only needed for the New Relic variants: their
# agents refuse to emit distributed-tracing headers until they have connected
# to the collector and received an account/app id. A free-tier key works.
NEW_RELIC_LICENSE_KEY=

# Optional: seconds to wait after priming a New Relic relay before measuring.
# NEWRELIC_SETTLE_SECONDS=10
