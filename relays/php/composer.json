{
    "name": "cpmatrix/relay-php",
    "description": "Naive relay for the context propagation matrix (PHP). Never touches headers or tracing APIs.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-grpc": "*",
        "ext-rdkafka": "*",
        "slim/slim": "4.15.3",
        "slim/psr7": "1.8.0",
        "php-amqplib/php-amqplib": "3.7.5",
        "grpc/grpc": "1.85.0",
        "google/protobuf": "5.36.2"
    },
    "autoload": {
        "psr-4": {
            "Relay\\": "src/",
            "Cpmatrix\\": "gen/Cpmatrix/",
            "GPBMetadata\\": "gen/GPBMetadata/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
