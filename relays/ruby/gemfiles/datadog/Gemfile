# Gemfile for the datadog target.
# Versions pinned exactly for repeatability (Dependabot bumps them).
#
# Kafka client is karafka (+ its waterdrop producer), NOT rdkafka/ruby-kafka:
# dd-trace-rb has no rdkafka integration and its ruby-kafka integration only
# creates spans (no context propagation). See README.
#
# bunny is present but UNINSTRUMENTED: dd-trace-rb has no bunny integration
# (RabbitMQ support is limited to the Sneakers/Kicks worker framework). That
# absence is a measured finding. See README.
source 'https://rubygems.org'

gem 'bunny', '3.4.0'
gem 'grpc', '1.84.1'
gem 'karafka', '2.6.1'
gem 'puma', '8.0.2'
gem 'rackup', '2.3.1'
gem 'sinatra', '4.2.1'
gem 'waterdrop', '2.10.7'

gem 'datadog', '2.42.0'
