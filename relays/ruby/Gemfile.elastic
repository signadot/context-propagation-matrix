# Gemfile for the elastic target.
#
# Kafka client is rdkafka (matching the otel target) and RabbitMQ is bunny.
# elastic-apm auto-instruments neither, and its grpc support needs
# interceptors added in app code (which the harness contract forbids), so
# only the http legs (rack/sinatra inbound, net/http outbound) are
# instrumented. Those gaps are measured findings. See README.
source 'https://rubygems.org'

gem 'bunny', '~> 3.3'
gem 'grpc', '~> 1.70'
gem 'puma', '~> 8.0'
gem 'rackup', '~> 2.2'
gem 'rdkafka', '~> 0.29'
gem 'sinatra', '~> 4.1'

gem 'elastic-apm', '~> 4.9'
