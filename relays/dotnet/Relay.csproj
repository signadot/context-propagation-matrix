<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Relay</AssemblyName>
    <RootNamespace>CpMatrix.RelayApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.14.2" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

  <!-- The proto lives at the repo root (proto/relay.proto). The Dockerfile
       preserves the same relative layout (build context = repo root, sources
       under /src/relays/dotnet, proto under /src/proto), so this relative
       path resolves both locally and inside the image build. -->
  <ItemGroup>
    <Protobuf Include="../../proto/relay.proto" ProtoRoot="../../proto" GrpcServices="Both" Link="Protos/relay.proto" />
  </ItemGroup>

</Project>
